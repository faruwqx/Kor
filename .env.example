# Bu dosyayı ".env.local" adıyla kopyala ve değerleri doldur. ".env.local" git'e girmez.
# Değerler boşsa uygulama eskisi gibi yalnızca cihazda çalışır (hesap ve Premium kapalı).

# Supabase paneli > Project Settings > API
VITE_SUPABASE_URL=
# "anon" / "publishable" anahtar. Tarayıcıya gömülür, gizli değildir; korumayı RLS sağlar.
# "service_role" / "secret" anahtarı BURAYA ASLA yazma.
VITE_SUPABASE_ANON_KEY=

# Apple ile giriş düğmesi. Apple Developer üyeliği (yıllık 99 $) ve Supabase'de Apple
# sağlayıcısı kurulduktan sonra 1 yap.
VITE_AUTH_APPLE=0

# Ödeme sayfası adresi (Paddle, Lemon Squeezy vb.). Boşsa "Premium'a geç" düğmesi
# ödemenin henüz açılmadığını söyler. Adrese plan, tier ve uid eklenir.
VITE_CHECKOUT_URL=
